{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.shots.config.ts",
    "tests/**/*.ts",
    "e2e/**/*.ts",
    "src/sim/**/*.ts",
    "src/config.ts",
    "src/timer/**/*.ts",
    "src/environment/**/*.ts"
  ]
}
